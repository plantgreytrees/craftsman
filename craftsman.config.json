{
  "enabled": true,
  "execution": {
    "agentMode": "root-only",
    "builtinAgents": ["Explore"],
    "engine": "workflow",
    "unitContextBytes": 122880
  },
  "timeoutMs": 20000,
  "maxFeedbackLines": 40,
  "noisePatterns": [
    "^Found \\d+ error",
    "^\\d+ (problems?|errors?|warnings?)",
    "^\\[\\*\\] \\d+ fixable",
    "^error(\\[E\\d+\\])?: aborting",
    "^warning: .* generated \\d+ warning",
    "^(Compiling|Checking|Finished|Building|Restored) ",
    "^Build succeeded",
    "^Build FAILED",
    "^\\s*\\d+ (Error|Warning)\\(s\\)",
    "^Time Elapsed",
    "^Test Run ",
    "^\\s*Passed!",
    "^\\s*Failed!",
    "^All checks passed",
    "^Success: no issues found",
    "^\\s*\\|",
    "^\\s*-->",
    "^(note|help): ",
    "^\\s*$"
  ],
  "baselineNewOnly": true,
  "ignore": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/venv/**",
    "**/target/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/bin/**",
    "**/obj/**",
    "**/vendor/**",
    "**/.git/**",
    "**/.next/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/.svelte-kit/**",
    "**/coverage/**",
    "**/__pycache__/**",
    "**/.craftsman/**",
    "**/*.min.js",
    "**/*.lock",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/*.pb.go",
    "**/*_pb2.py",
    "**/*.generated.*",
    "**/migrations/**"
  ],
  "protectedPaths": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/target/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/.svelte-kit/**",
    "**/*.generated.*",
    "**/*.pb.go",
    "**/*_pb2.py",
    "**/*.min.js",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/*.lock",
    "**/.env",
    "**/.env.*"
  ],
  "learnedRules": {
    "enabled": true,
    "max": 10,
    "minOccurrences": 3,
    "maxAgeMs": 2592000000
  },
  "planMemory": {
    "enabled": true,
    "maxAgeMs": 3888000000
  },
  "tracker": {
    "nudgeLines": 300
  },
  "repoExec": {
    "verifyTestsBeforeMerge": true,
    "land": "direct",
    "host": "auto",
    "autoMerge": true,
    "mergeMethod": "merge"
  },
  "baseline": {
    "errorsDoc": "docs/errors/KNOWN_ISSUES.md"
  },
  "stopGate": {
    "enabled": true,
    "snapshotAtStart": true,
    "requireAcceptanceCriteria": true,
    "testTimeoutMs": 250000,
    "totalBudgetMs": 280000,
    "commands": {
      "package.json": "npm test --silent",
      "Cargo.toml": "cargo test --quiet",
      "pyproject.toml": "pytest -q",
      "requirements.txt": "pytest -q",
      "go.mod": "go test ./...",
      "pom.xml": "mvn -q test",
      "build.gradle": "gradle test -q",
      "Gemfile": "bundle exec rake",
      "*.sln": "dotnet test --nologo -v quiet",
      "composer.json": "composer test"
    },
    "extraChecks": []
  },
  "security": {
    "enabled": true,
    "builtinFallback": true,
    "check": [
      "gitleaks dir . --no-banner --redact"
    ]
  },
  "docWriteGuard": {
    "enabled": true,
    "ttlMs": 3600000,
    "pendingTtlMs": 1800000,
    "docPaths": ["docs/plans/**", "docs/ideas/**", "docs/architecture/**"]
  },
  "planning": {
    "blindRederivation": "never"
  },
  "architecture": {
    "enforce": true,
    "dir": "docs/architecture"
  },
  "sessionContext": {
    "verbose": false
  },
  "languages": {
    "python": {
      "extensions": [".py"],
      "format": ["ruff format -q {file}"],
      "check": ["ruff check --output-format=concise {file}"]
    },
    "typescript": {
      "extensions": [".ts", ".tsx"],
      "format": ["prettier --write --log-level silent {file}"],
      "check": ["eslint --no-color --format unix {file}"]
    },
    "javascript": {
      "extensions": [".js", ".jsx", ".mjs", ".cjs"],
      "format": ["prettier --write --log-level silent {file}"],
      "check": ["eslint --no-color --format unix {file}"]
    },
    "vue": {
      "extensions": [".vue"],
      "format": ["prettier --write --log-level silent {file}"],
      "check": ["eslint --no-color --format unix {file}"]
    },
    "svelte": {
      "extensions": [".svelte"],
      "format": ["prettier --write --log-level silent {file}"],
      "check": ["eslint --no-color --format unix {file}"]
    },
    "go": {
      "extensions": [".go"],
      "format": ["gofmt -w {file}", "goimports -w {file}"],
      "check": ["go vet ./{dir}", "staticcheck ./{dir}"],
      "projectScoped": true
    },
    "rust": {
      "extensions": [".rs"],
      "format": ["rustfmt --edition 2021 {file}"],
      "check": ["cargo clippy --quiet --message-format short --all-targets"],
      "projectScoped": true
    },
    "ruby": {
      "extensions": [".rb"],
      "format": ["rubocop -a {file}"],
      "check": ["rubocop --format emacs {file}"]
    },
    "php": {
      "extensions": [".php"],
      "format": ["php-cs-fixer fix {file} -q"],
      "check": ["phpstan analyse {file} --no-progress --error-format=raw"]
    },
    "shell": {
      "extensions": [".sh", ".bash"],
      "format": [],
      "check": ["shellcheck -f gcc {file}"]
    },
    "csharp": {
      "extensions": [".cs"],
      "format": ["dotnet format --include {file} -v quiet"],
      "check": []
    },
    "java": {
      "extensions": [".java"],
      "format": ["google-java-format -i {file}"],
      "check": ["checkstyle -c /google_checks.xml {file}"]
    },
    "cpp": {
      "extensions": [".c", ".h", ".cc", ".cpp", ".hpp", ".hh"],
      "format": ["clang-format -i {file}"],
      "check": ["clang-tidy {file} --quiet"]
    },
    "elixir": {
      "extensions": [".ex", ".exs"],
      "format": ["mix format {file}"],
      "check": ["mix credo {file}"]
    },
    "dart": {
      "extensions": [".dart"],
      "format": ["dart format {file}"],
      "check": ["dart analyze {file}"]
    },
    "terraform": {
      "extensions": [".tf", ".tfvars"],
      "format": ["terraform fmt {file}"],
      "check": ["tflint {file}"]
    },
    "dockerfile": {
      "extensions": [],
      "filenames": ["Dockerfile"],
      "format": [],
      "check": ["hadolint {file}"]
    },
    "swift": {
      "extensions": [".swift"],
      "format": ["swiftformat {file}"],
      "check": ["swiftlint lint --quiet {file}"]
    },
    "kotlin": {
      "extensions": [".kt", ".kts"],
      "format": ["ktlint -F {file}"],
      "check": ["ktlint {file}"]
    },
    "kubernetes": {
      "extensions": [],
      "paths": [
        "**/k8s/**/*.yaml", "**/k8s/**/*.yml",
        "**/kubernetes/**/*.yaml", "**/kubernetes/**/*.yml",
        "**/manifests/**/*.yaml", "**/manifests/**/*.yml",
        "**/charts/**/templates/**/*.yaml", "**/charts/**/templates/**/*.yml"
      ],
      "format": [],
      "check": ["kube-linter lint {file}"]
    }
  }
}
