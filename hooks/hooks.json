{
  "modules": ["./register.js"],
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" scripts/session-context.mjs", "timeout": 60 } ] },
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" scripts/tracker-sync.mjs", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Read|Glob|Grep|Write|Edit|NotebookEdit|Bash",
        "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" scripts/pre-guard.mjs", "timeout": 10, "onFailure": "block" } ] },
      { "matcher": "Task|Agent|Workflow",
        "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" scripts/agent-mode-guard.mjs", "timeout": 10, "onFailure": "block" } ] },
      { "matcher": "Skill",
        "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" scripts/builtin-skill-context.mjs", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit",
        "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" scripts/quality-gate.mjs", "timeout": 60 } ] },
      { "matcher": "Bash|Write|Edit",
        "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" scripts/tracker-sync.mjs", "timeout": 10 } ] },
      { "matcher": "Skill",
        "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" scripts/orchestrate-scope-guard.mjs", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" scripts/orchestrate-scope-guard.mjs", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" scripts/session-end.mjs", "timeout": 20 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" scripts/stop-gate.mjs", "timeout": 300 } ] },
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" scripts/tracker-sync.mjs", "timeout": 10 } ] },
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" scripts/telemetry.mjs", "timeout": 10 } ] }
    ]
  }
}
