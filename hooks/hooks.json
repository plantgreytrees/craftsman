{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-context.mjs\"", "timeout": 60 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Read|Glob|Grep|Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pre-guard.mjs\"", "timeout": 10 } ] },
      { "matcher": "Task",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/agent-mode-guard.mjs\"", "timeout": 10 } ] },
      { "matcher": "Read|Glob|Grep|Write|Edit|MultiEdit|NotebookEdit|Bash|Task|TodoWrite|SlashCommand",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/compact-gate.mjs\"", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/quality-gate.mjs\"", "timeout": 60 } ] },
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/compact-nudge.mjs\"", "timeout": 10 } ] },
      { "matcher": "SlashCommand",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/orchestrate-scope-guard.mjs\"", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-gate.mjs\"", "timeout": 300 } ] }
    ]
  }
}
